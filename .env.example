# Copy to .env and fill in. .env is gitignored; never commit real values.

# Django
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=10.1.1.19,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://10.1.1.19
# Under Apache at /mrp:
STATIC_URL=/mrp/static/
COOKIE_PATH=/mrp
SECURE_COOKIES=False

# Database (own PostgreSQL database, NOT westridgeApp's)
DATABASE_URL=postgres://mrp_user:change-me@localhost:5432/mrp

# Acumatica (read-only service user; OData on Generic Inquiries)
ACUMATICA_BASE_URL=https://yourcompany.acumatica.com
ACUMATICA_TENANT=Your Tenant Name
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_TIMEOUT=60
# Optional GI name overrides (defaults shown)
# ACUMATICA_GI_STOCK_ITEMS=MRP-StockItems
# ACUMATICA_GI_ON_HAND=MRP-OnHand
# ACUMATICA_GI_OPEN_PO_LINES=MRP-OpenPOLines
# ACUMATICA_GI_BOM=MRP-BOM
# ACUMATICA_GI_VENDORS=MRP-Vendors
# ACUMATICA_GI_ITEM_VENDORS=MRP-ItemVendors
# ACUMATICA_GI_PO_HISTORY=MRP-POHistory
# ACUMATICA_GI_DEMAND_SHIPMENTS=MRP-DemandShipments
# ACUMATICA_GI_DEMAND_SALES_ORDERS=MRP-DemandSalesOrders
# ACUMATICA_GI_DEMAND_FORECAST=MRP-DemandForecast

# Email (Fastmail, app-specific password)
EMAIL_HOST=smtp.fastmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
MRP_REMINDER_TO=purchasing@example.com
MRP_SITE_URL=http://10.1.1.19/mrp
