# Copy to .env and fill in. .env is gitignored; never commit real values.

# Django
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=10.1.1.32,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://10.1.1.32
# Under Apache at /mrp:
STATIC_URL=/mrp/static/
COOKIE_PATH=/mrp
SECURE_COOKIES=False

# Database (own PostgreSQL database, NOT westridgeApp's)
DATABASE_URL=postgres://mrp_user:change-me@localhost:5432/mrp

# Acumatica (read-only, contract-based REST API; see docs/acumatica_access.md)
ACUMATICA_BASE_URL=https://yourcompany.acumatica.com
ACUMATICA_TENANT='Your Tenant Name'
ACUMATICA_BRANCH=
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_TIMEOUT=120
ACUMATICA_ENDPOINT=Default/24.200.001
ACUMATICA_MANUFACTURING_ENDPOINT=MANUFACTURING/24.200.001
# Sales order types that count as demand (comma-separated)
ACUMATICA_SALES_ORDER_TYPES=SO

# Email (Fastmail, app-specific password)
EMAIL_HOST=smtp.fastmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
MRP_REMINDER_TO=purchasing@example.com
MRP_SITE_URL=http://10.1.1.32/mrp
